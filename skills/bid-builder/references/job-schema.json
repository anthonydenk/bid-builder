{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bid Builder job",
  "type": "object",
  "required": ["naming_line", "project", "proposal_number", "customer", "location", "grouping_confirmed", "sections"],
  "properties": {
    "naming_line": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "proposal_number": {"type": "string", "minLength": 1},
    "customer": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "grouping_confirmed": {"const": true},
    "proposal_date": {"type": ["string", "null"]},
    "plan_date": {"type": ["string", "null"]},
    "prepared_by": {"type": ["string", "null"]},
    "attention": {"type": ["string", "null"]},
    "email": {"type": ["string", "null"]},
    "phone": {"type": ["string", "null"]},
    "clauses_profile": {"type": "string", "default": "general_draft"},
    "clauses_approved": {"type": "boolean", "default": false},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "kind", "source_files"],
        "properties": {
          "title": {"type": "string"},
          "group_title": {"type": ["string", "null"]},
          "kind": {"enum": ["accessories", "partitions", "other"]},
          "source_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "scope_summary": {"type": ["string", "null"]},
          "manufacturer": {"type": ["string", "null"]},
          "installation_basis": {"enum": ["Furnished Only", "Furnished & Installed", null]}
        }
      }
    }
  }
}
